# Public origin of this docs site. Used for canonicals, Open Graph URLs, the sitemap,
# llms.txt and JSON-LD. Defaults to https://docs.veriworkly.com.
SITE_URL=http://localhost:3002

# Origins the API playground proxy (/api/proxy) may forward requests to, comma-separated.
# Defaults to https://api.veriworkly.com. Only /api/v1/* paths are forwarded.
ALLOWED_ORIGINS=https://api.veriworkly.com

# Set in CI: makes `npm run generate:api` exit 1 when an API page is missing from a meta.json.
# API_DOCS_STRICT=1
