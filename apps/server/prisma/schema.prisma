// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

// User model for authentication and resume ownership
model User {
  id                    String                @id @default(cuid())
  email                 String                @unique
  name                  String?
  username              String?               @unique
  emailVerified         Boolean               @default(false)
  image                 String?
  autoSyncEnabled       Boolean               @default(true)
  affiliateStatus       AffiliateStatus       @default(NOT_ENROLLED)
  affiliateTier         AffiliateTier         @default(TIER_1)
  // When an admin last set the tier by hand. Automatic promotion needs a threshold crossed after
  // it, so a demotion holds until the next milestone. On the row, not read from the admin audit
  // log, so audit retention can never undo it.
  affiliateTierDecidedAt DateTime?
  affiliateCode         String?               @unique
  affiliateEnrolledAt   DateTime?
  role                  Role                  @default(USER)
  ambassadorStatus      String                @default("NONE")
  ambassadorApplication AmbassadorApplication?
  lastLinkedinImportAt  DateTime?
  lastGithubImportAt    DateTime?
  // The Dodo customer id, recorded from every successful payment (V-175): a pass or credit-pack
  // buyer has no Subscription row, and the billing portal needs a customer to open.
  billingCustomerId     String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  sessions              Session[]
  accounts              Account[]
  resumes               Document[]
  masterProfile         MasterProfile?
  shareLinks            ShareLink[]
  roadmapInteractions   RoadmapInteraction[]
  apiKeys               ApiKey[]
  subscriptions         Subscription[]
  billingWebhookEvents  BillingWebhookEvent[]
  billingNotifications  BillingNotification[]
  creditSchedules       SubscriptionCreditSchedule[]
  entitlementGrants     EntitlementGrant[]
  creditWallet          CreditWallet?
  creditTransactions    CreditTransaction[]
  creditGrants          CreditGrant[]
  creditReservations    CreditReservation[]
  affiliateReferrals    AffiliateReferral[]   @relation("AffiliateOwner")
  referredByAffiliate   AffiliateReferral?    @relation("ReferredUser")
  affiliateClicks       AffiliateClick[]
  affiliateCommissions  AffiliateCommission[] @relation("AffiliateCommissionOwner")
  affiliateWallet       AffiliateWallet?
  affiliateWithdrawals  AffiliateWithdrawal[]
  adminAuditEntries     AdminAuditEntry[]     @relation("AdminAuditActor")
  portfolioPublication  PortfolioPublication?
  portfolioAssets       PortfolioAsset[]

  // Admin overview signup windows and the signups series (V-070/V-105).
  @@index([createdAt])
  // Admin user search is `contains` + `mode: insensitive` (leading-wildcard ILIKE), which only a
  // trigram index can serve. Needs the `pg_trgm` extension, created by hand in migration
  // 20261025160000_admin_query_indexes (Prisma does not manage extensions here).
  // The admin overview's users-by-role count and the role filter (V-070).
  @@index([role])
  @@index([email(ops: raw("gin_trgm_ops"))], map: "User_email_trgm_idx", type: Gin)
  @@index([name(ops: raw("gin_trgm_ops"))], map: "User_name_trgm_idx", type: Gin)
  @@index([username(ops: raw("gin_trgm_ops"))], map: "User_username_trgm_idx", type: Gin)
}

enum Role {
  USER
  AMBASSADOR
  ADMIN
}

enum AffiliateStatus {
  NOT_ENROLLED
  PENDING
  ACTIVE
  SUSPENDED
}

enum AffiliateTier {
  TIER_1
  TIER_2
  TIER_3
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@unique([identifier, value])
  @@index([identifier])
  @@index([expiresAt])
}

enum DocumentType {
  RESUME
  COVER_LETTER
  PORTFOLIO
  LINK_IN_BIO
}

enum Visibility {
  PRIVATE
  UNLISTED
  PUBLIC
}

// Unified Document model for all product types
model Document {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type  DocumentType @default(RESUME)
  title String       @default("Untitled Document")
  slug  String // Current editable document slug
  tags  String[]     @default([])

  // A PORTFOLIO draft's chosen subdomain (V-301); null on every other type. Kept apart from
  // `slug`, which is unique per user across every document (trashed ones included) and follows
  // the title, so a subdomain matching a résumé's slug or a trashed draft's was refused, and a
  // rename moved it. Not unique: the name is claimed by `PortfolioPublication.subdomain` on publish.
  portfolioSubdomain String?

  content  Json // The main content (JSON Resume standard)
  metadata Json? // UI state, favorites, tags, etc.

  templateId    String @default("modern")
  schemaVersion Int    @default(1)
  revision      Int    @default(1) // Optimistic concurrency control

  visibility Visibility @default(PRIVATE)

  // Sync metadata
  lastSyncedAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // Soft delete

  // When a moderator made this document private ("Make private", or a portfolio force-unpublish).
  // While set, the owner cannot share, unlist or publish it; only a moderator lifts it ("Make
  // unlisted", or setting its portfolio back to LIVE). Stored on the row, not read from the admin
  // audit log, so audit retention can never lift a takedown (V-207).
  moderatedPrivateAt DateTime?

  shareLinks           ShareLink[]
  portfolioPublication PortfolioPublication?

  @@unique([userId, slug])
  @@index([userId, type, deletedAt, updatedAt])
  @@index([userId, deletedAt, updatedAt])
  @@index([createdAt])
  @@index([deletedAt])
  // The admin document list: default sort, and its title/slug search (V-070, V-111).
  @@index([updatedAt])
  @@index([title(ops: raw("gin_trgm_ops"))], map: "Document_title_trgm_idx", type: Gin)
  @@index([slug(ops: raw("gin_trgm_ops"))], map: "Document_slug_trgm_idx", type: Gin)
}

// No TRIALING. VeriWorkly does not offer a free trial on any plan, and never had a
// paying subscriber while the short-lived Creator Pro trial existed, so there are no
// rows to migrate. If a trial is ever reintroduced, this value comes back together
// with the disclosure and reminder machinery that a trial requires.
enum SubscriptionStatus {
  INACTIVE
  ACTIVE
  PAST_DUE
  CANCELED
}

enum BillingInterval {
  ONE_DAY
  SEVEN_DAY
  MONTHLY
  ANNUAL
}

// Billing rows (Subscription, EntitlementGrant, CreditWallet, CreditTransaction, CreditGrant and
// their allocations) outlive the account: deleting a user detaches them (`userId` set null) so
// the payment history is kept for tax and disputes (owner decision 5, V-183). Every reader must
// treat a null `userId` as "the account was deleted", never as a user to recreate.
model Subscription {
  id                 String             @id @default(cuid())
  userId             String?
  user               User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  provider           String
  providerCustomerId String?
  providerPriceId    String?
  providerSubId      String?            @unique
  productKey         String             @default("portfolio_pro")
  status             SubscriptionStatus @default(INACTIVE)
  interval           BillingInterval?
  rawStatus          String?
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean            @default(false)
  graceEndsAt        DateTime?
  lastWebhookAt      DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([userId, status])
  @@index([userId, productKey, status])
  @@index([userId, updatedAt])
  @@index([createdAt])
  @@index([status, createdAt])
}

enum EntitlementSource {
  SUBSCRIPTION
  MANUAL
  PROMOTION
  SYSTEM
}

model EntitlementGrant {
  id        String            @id @default(cuid())
  userId    String?
  user      User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  key       String
  source    EntitlementSource
  sourceId  String
  startsAt  DateTime          @default(now())
  endsAt    DateTime?
  revokedAt DateTime?
  metadata  Json?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@unique([userId, key, source, sourceId])
  @@index([userId, key, startsAt, endsAt, revokedAt])
  @@index([source, sourceId])
  // The admin's global count of active grants (V-105): not revoked, started, not ended.
  @@index([revokedAt, endsAt, startsAt])
}

enum CreditTransactionType {
  GRANT
  DEBIT
  REFUND
  ADJUSTMENT
  EXPIRATION
}

model CreditWallet {
  id               String              @id @default(cuid())
  // Detached, not deleted, with the account: its transactions and grants are billing records.
  userId           String?             @unique
  user             User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  balance          Int                 @default(0)
  reserved         Int                 @default(0)
  lifetimeCredited Int                 @default(0)
  lifetimeDebited  Int                 @default(0)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  transactions     CreditTransaction[]
  grants           CreditGrant[]
  reservations     CreditReservation[]

  @@index([updatedAt])
}

enum CreditReservationStatus {
  PENDING
  COMMITTED
  RELEASED
  EXPIRED
}

model CreditReservation {
  id        String                  @id @default(cuid())
  walletId  String
  wallet    CreditWallet            @relation(fields: [walletId], references: [id], onDelete: Cascade)
  userId    String
  user      User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Unique per user, not globally: the id is client-supplied, so one user's UUID must never
  // 409 another user's request (or leak that it exists).
  requestId String
  action    String
  cost      Int
  status    CreditReservationStatus @default(PENDING)
  expiresAt DateTime
  // What the committed request returned (the AI draft), written in the commit's own transaction
  // so a retry with the same requestId after a lost response gets it back instead of a 409 and
  // is never charged twice (V-192). Cleared by the retention job after
  // RETENTION_CREDIT_REPLAY_DAYS; a replay after that answers 409 as before.
  replay    Json?
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt

  @@unique([userId, requestId])
  @@index([userId, status, expiresAt])
  @@index([walletId, status])
  @@index([status, updatedAt])
  // Also "CreditReservation_sweep_idx" ("expiresAt", "userId") WHERE status = 'PENDING': a
  // partial index for the credit sweep job, hand-written in migration
  // 20261025160000_admin_query_indexes because Prisma cannot model partial indexes. Likewise
  // "CreditReservation_replay_idx" ("updatedAt") WHERE replay IS NOT NULL, for the retention
  // job's replay clearing (migration 20261026160000_ai_replay_and_billing_event_summary).
}

model CreditTransaction {
  id           String                  @id @default(cuid())
  walletId     String
  wallet       CreditWallet            @relation(fields: [walletId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?                   @relation(fields: [userId], references: [id], onDelete: SetNull)
  type         CreditTransactionType
  amount       Int
  balanceAfter Int
  action       String?
  // Per-user idempotency key (see CreditReservation.requestId); server-minted ids carry their
  // own prefix (payment-credit:, subscription-credit:, admin-credit:, expire:).
  requestId    String?
  documentId   String?
  referenceId  String?
  reason       String?
  metadata     Json?
  createdAt    DateTime                @default(now())
  allocations  CreditUsageAllocation[]

  @@unique([userId, requestId])
  @@index([userId, createdAt])
  @@index([walletId, createdAt])
  @@index([referenceId])
  @@index([type, createdAt])
}

model CreditGrant {
  id          String                  @id @default(cuid())
  walletId    String
  wallet      CreditWallet            @relation(fields: [walletId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?                   @relation(fields: [userId], references: [id], onDelete: SetNull)
  amount      Int
  remaining   Int
  source      String
  sourceId    String
  expiresAt   DateTime?
  createdAt   DateTime                @default(now())
  allocations CreditUsageAllocation[]

  @@unique([userId, source, sourceId])
  @@index([userId, expiresAt, remaining])
  @@index([walletId, expiresAt, remaining])
  // Also "CreditGrant_sweep_idx" ("expiresAt", "userId") WHERE remaining > 0: a partial index
  // the credit sweep job relies on. Prisma cannot model partial indexes, so it is hand-written in
  // migration 20261025160000_admin_query_indexes; do not let `migrate dev` drop it.
}

model CreditUsageAllocation {
  id            String            @id @default(cuid())
  transactionId String
  transaction   CreditTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  grantId       String
  grant         CreditGrant       @relation(fields: [grantId], references: [id], onDelete: Restrict)
  amount        Int
  createdAt     DateTime          @default(now())

  @@unique([transactionId, grantId])
  @@index([grantId, createdAt])
}

enum AffiliateReferralStatus {
  SIGNED_UP
  CONVERTED
  REJECTED
}

model AffiliateReferral {
  id             String                  @id @default(cuid())
  affiliateId    String
  affiliate      User                    @relation("AffiliateOwner", fields: [affiliateId], references: [id], onDelete: Cascade)
  referredUserId String                  @unique
  referredUser   User                    @relation("ReferredUser", fields: [referredUserId], references: [id], onDelete: Cascade)
  code           String
  // sha256(value + ANALYTICS_HASH_PEPPER) of the referred user's request IP and User-Agent when
  // the code was applied (V-016). The IP hash is compared with the affiliate's own session
  // addresses to flag a possible alt account (`sharedAddressWithAffiliate`), never to refuse the
  // referral; nothing is stored in clear.
  ipHash         String?
  userAgentHash  String?
  // True when `ipHash` matched one of the affiliate's own session addresses at apply time. The
  // referral is still recorded (campus NATs are legitimate); its commissions are forced PENDING
  // for review instead.
  sharedAddressWithAffiliate Boolean @default(false)
  status         AffiliateReferralStatus @default(SIGNED_UP)
  convertedAt    DateTime?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  commissions    AffiliateCommission[]

  @@index([affiliateId, status, createdAt])
  @@index([code, createdAt])
}

model AffiliateClick {
  id            String   @id @default(cuid())
  affiliateId   String
  affiliate     User     @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  code          String
  referrerHost  String?
  ipHash        String?
  userAgentHash String?
  createdAt     DateTime @default(now())

  @@index([affiliateId, createdAt])
  @@index([code, createdAt])
  @@index([createdAt])
}

enum AffiliateCommissionStatus {
  PENDING
  AVAILABLE
  REVERSED
  PAID
}

model AffiliateCommission {
  id                String                    @id @default(cuid())
  // Money history outlives the account: deleting the affiliate detaches the row instead of
  // erasing what was earned and paid out. A detached PENDING commission can no longer be released.
  affiliateId       String?
  affiliate         User?                     @relation("AffiliateCommissionOwner", fields: [affiliateId], references: [id], onDelete: SetNull)
  referralId        String?
  referral          AffiliateReferral?        @relation(fields: [referralId], references: [id], onDelete: SetNull)
  subscriptionId    String?
  providerPaymentId String?                   @unique
  amountCents       Int
  // ISO 4217 code of `amountCents`. Dodo settles the account in USD and `AffiliateWallet` is a USD
  // balance, so only USD commissions move wallet cents; any other currency is stored PENDING with
  // its currency and must be converted and recorded by an admin before it can be released (V-017).
  currency          String                    @default("USD")
  rateBps           Int
  status            AffiliateCommissionStatus @default(PENDING)
  availableAt       DateTime?
  // Set when a payout covered this commission (V-017): the withdrawal marked PAID that paid it.
  // Kept on a commission later REVERSED by a refund, so the claw-back knows the money had left.
  paidAt            DateTime?
  withdrawalId      String?
  withdrawal        AffiliateWithdrawal?      @relation(fields: [withdrawalId], references: [id], onDelete: SetNull)
  reversedAt        DateTime?
  // What a refund or lost dispute could not take back from the wallet when it reversed this
  // commission (V-205): the part already withdrawn or paid out, added to the wallet's
  // `clawbackCents`. Zero for every other reversal.
  clawbackCents     Int                       @default(0)
  reason            String?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  @@index([affiliateId, status, createdAt])
  @@index([referralId, createdAt])
  @@index([subscriptionId])
  @@index([status, createdAt])
  @@index([withdrawalId])
}

model AffiliateWallet {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pendingCents   Int      @default(0)
  availableCents Int      @default(0)
  paidCents      Int      @default(0)
  // Owed back by the affiliate (V-205): commission reversed by a refund or a lost dispute after
  // its money had left the available balance (withdrawn or paid out). Every later credit to
  // `availableCents` repays this first (services/affiliate/commissions `creditAvailable`).
  clawbackCents  Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

enum AffiliateWithdrawalStatus {
  REQUESTED
  APPROVED
  REJECTED
  PAID
}

model AffiliateWithdrawal {
  id          String                    @id @default(cuid())
  // Detached, not deleted, with the account (payout history). An open withdrawal still blocks
  // deletion in userService / adminUserService.
  userId      String?
  user        User?                     @relation(fields: [userId], references: [id], onDelete: SetNull)
  amountCents Int
  // ISO 4217 code of `amountCents`; always USD today because the wallet it draws from is USD.
  currency    String                    @default("USD")
  status      AffiliateWithdrawalStatus @default(REQUESTED)
  payoutNote  String?
  reviewedBy  String?
  reviewedAt  DateTime?
  paidAt      DateTime?
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
  commissions AffiliateCommission[]

  @@index([userId, status, createdAt])
  @@index([status, createdAt])
  // Partial unique index `AffiliateWithdrawal_one_active_per_user` on (userId) WHERE status IN
  // (REQUESTED, APPROVED), created by raw SQL in the affiliate_currency_and_payout_guards migration
  // because Prisma cannot express a predicate. `requestWithdrawal` maps its P2002 to 409.
}

enum AmbassadorApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

model AmbassadorApplication {
  id             String                      @id @default(cuid())
  userId         String                      @unique
  user           User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  collegeName    String
  graduationYear String
  whyJoin        String
  superpower     String
  funFact        String
  vibeCheck      String?
  socialHandle   String?
  status         AmbassadorApplicationStatus @default(PENDING)
  reviewedBy     String?
  reviewedAt     DateTime?
  reviewNote     String?
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt

  @@index([status, createdAt])
}

model AdminAuditEntry {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation("AdminAuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  targetType String
  targetId   String?
  reason     String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([targetType, targetId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
  // Account deletion finds the entries about a user by target alone (V-237). Also hand-written
  // expression indexes "AdminAuditEntry_metadata_userId_idx" / "_metadata_ownerId_idx" on
  // (metadata ->> 'userId' / 'ownerId'), migration 20261027140000; Prisma cannot model them.
  @@index([targetId])
}

enum PortfolioPublicationStatus {
  LIVE
  GRACE
  SUSPENDED
}

model PortfolioPublication {
  id                String                     @id @default(cuid())
  userId            String                     @unique
  user              User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentId        String                     @unique
  document          Document                   @relation(fields: [documentId], references: [id], onDelete: Cascade)
  subdomain         String                     @unique
  templateId        String
  snapshot          Json
  status            PortfolioPublicationStatus @default(LIVE)
  publishedRevision Int                        @default(1)
  suspensionReason  String?
  suspendedAt       DateTime?
  // The owner's or billing's own suspension reason a moderation lock covers, restored when the
  // lock lifts; null when the site was online as the lock went on (V-285).
  reasonBeforeModeration String?
  // The latest publish: moves on every republish.
  publishedAt       DateTime                   @default(now())
  // When the site first went online: set once on create, never updated (V-288). The admin
  // dashboard's publication counts use this, so a republish does not re-date a site.
  firstPublishedAt  DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  views             PortfolioViewDaily[]

  @@index([status, updatedAt])
  @@index([publishedAt])
  @@index([firstPublishedAt])
}

enum BillingWebhookStatus {
  PROCESSING
  PROCESSED
  FAILED
}

model BillingWebhookEvent {
  id              String               @id @default(cuid())
  providerEventId String               @unique
  userId          String?
  user            User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  type            String
  payload         Json
  // What the event was for, as the customer's billing history shows it (V-197). Written when the
  // event is stored so the row keeps it after the retention job redacts `payload`. Null when the
  // event names no known product or amount.
  productName     String?
  amountCents     Int?
  currency        String?
  // The provider payment a payment.*, refund.* or dispute.* event is about (V-216): refunds and
  // disputes find the payment they reverse through this indexed column, not a jsonb path, and it
  // survives the retention job's payload redaction. Null for subscription events.
  providerPaymentId String?
  // The subscription a plan-change charge upgraded (V-372), null for every other event. Written
  // when the event is stored, so a refund or chargeback still finds the upgrade it paid for after
  // the retention job has redacted `payload`.
  planChangeSubscriptionId String?
  status          BillingWebhookStatus @default(PROCESSING)
  error           String?
  processedAt     DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  retryCount      Int                  @default(0)
  lastAttemptAt   DateTime?

  @@index([type, createdAt])
  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([providerPaymentId, type])
  @@index([planChangeSubscriptionId])
  // Also hand-written expression indexes for account deletion (V-237), migration 20261027140000:
  // "BillingWebhookEvent_payload_user_idx" (payload #>> '{data,metadata,veriworkly_user_id}') and
  // "BillingWebhookEvent_payload_subscription_idx" (payload #>> '{data,subscription_id}').
}

// One row per billing email (V-172, V-177): the unique (kind, reference) is what makes a
// purchase confirmation or a payment-failed notice go out once per payment, however often the
// provider redelivers the event. The row is the claim: `payload` holds what the email says (no
// address, no name), `sentAt` is set once the send succeeded, and a claim left unsent (a failed
// send, or a crash between claiming and sending) is retried by the hourly billing job
// (services/billingNotifications). Kept, detached, when the account is deleted.
model BillingNotification {
  id        String    @id @default(cuid())
  userId    String?
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  kind      String
  reference String
  payload   Json?
  claimedAt DateTime  @default(now())
  sentAt    DateTime?
  attempts  Int       @default(1)
  createdAt DateTime  @default(now())

  @@unique([kind, reference])
  @@index([userId, createdAt])
  @@index([sentAt, claimedAt])
}

// Annual plans are paid once a year but deliver credits monthly (owner decision 4): one schedule
// per paid annual period, opened by its payment, granting `monthlyCredits` at the start of each
// month (services/annualCreditService, jobs/annualCreditJob). Each month's grant expires when the
// month ends: nothing rolls over. Grants are keyed "<schedule id>:<month index>", so a retried
// webhook or two job runs never grant a month twice. `openedByPaymentId` is the payment that
// opened it, so a redelivery of that payment is never read as an early renewal. `stoppedAt` is
// set once the paid period has ended or the plan moved to one without credits.
model SubscriptionCreditSchedule {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerSubId     String
  productKey        String
  periodStart       DateTime
  periodEnd         DateTime
  monthlyCredits    Int
  openedByPaymentId String?
  stoppedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([providerSubId, periodStart])
  @@index([stoppedAt, periodEnd])
  @@index([userId])
}

enum PortfolioAssetKind {
  AVATAR
  PROJECT_COVER
  SOCIAL_IMAGE
}

enum PortfolioAssetStatus {
  PENDING
  READY
  /// Deleted by the owner while its upload URL was still valid; swept with the object (V-224).
  DELETED
}

model PortfolioAsset {
  id        String               @id @default(cuid())
  userId    String
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  key       String               @unique
  kind      PortfolioAssetKind
  mimeType  String
  sizeBytes Int
  checksum  String?
  status    PortfolioAssetStatus @default(PENDING)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([userId, status])
  @@index([status, createdAt])
}

model PortfolioViewDaily {
  id            String               @id @default(cuid())
  publicationId String
  publication   PortfolioPublication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  date          DateTime
  referrerHost  String               @default("")
  count         Int                  @default(0)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  // Its leading `(publicationId, date)` also serves per-publication date ranges, so the separate
  // `[publicationId, date]` index was dropped as redundant (V-105).
  @@unique([publicationId, date, referrerHost])
  @@index([date])
}

model MasterProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ShareLink {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  slug     String // Stable public URL slug
  snapshot Json // Static snapshot of document at share time

  passwordHash String?
  expiresAt    DateTime?
  viewCount    Int       @default(0)
  lastViewedAt DateTime?

  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  views     ShareView[]

  @@unique([userId, documentId])
  @@unique([userId, slug])
  @@index([documentId])
  // The admin share list: both sorts and the slug search (V-070, V-111).
  @@index([createdAt])
  @@index([viewCount])
  @@index([slug(ops: raw("gin_trgm_ops"))], map: "ShareLink_slug_trgm_idx", type: Gin)
}

model ShareView {
  id          String    @id @default(cuid())
  shareLinkId String
  shareLink   ShareLink @relation(fields: [shareLinkId], references: [id], onDelete: Cascade)
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime  @default(now())

  @@index([shareLinkId])
  @@index([createdAt])
}

// Roadmap Feature model
model RoadmapFeature {
  id               String               @id
  title            String
  description      String
  status           String               @default("todo") // "todo", "in-progress", "done"
  eta              String?
  tags             String[]             @default([])
  createdAt        DateTime             @default(now())
  startedAt        DateTime?
  completedAt      DateTime?
  completedQuarter String?
  updatedAt        DateTime             @updatedAt
  fullDescription  String?
  whyItMatters     String?
  timeline         String?
  details          Json?
  interactions     RoadmapInteraction[]

  // No `[status]` index: `[status, createdAt]` and `[status, completedAt, updatedAt]` lead with it.
  @@index([createdAt])
  @@index([status, createdAt])
  @@index([completedAt, updatedAt])
  @@index([status, completedAt, updatedAt])
}

// Track user interactions with roadmap (votes, bookmarks, comments)
model RoadmapInteraction {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  featureId String
  feature   RoadmapFeature @relation(fields: [featureId], references: [id], onDelete: Cascade)
  type      String // "vote", "bookmark", "comment"
  value     Int? // vote count
  comment   String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([userId, featureId, type])
  @@index([userId])
  @@index([featureId])
}

// Public product changelog entry — one row per shipped release/version.
model ChangelogEntry {
  id          String    @id
  version     String    @unique
  title       String
  summary     String?
  type        String    @default("minor") // "major", "minor", "patch"
  publishedAt DateTime
  githubUrl   String?
  added       String[]  @default([])
  improved    String[]  @default([])
  fixed       String[]  @default([])
  breaking    String[]  @default([])
  security    String[]  @default([])
  tags        String[]  @default([])
  prRefs      Json?
  // Set only by admin writes. The release sync re-parses an auto-synced entry's text while this
  // is null; `updatedAt` cannot say so, because the sync's own prRefs update moves it (V-066).
  editedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([publishedAt])
  @@index([type])
}

// A GitHub release an admin deleted from the changelog (V-289). The release sync creates any
// release with no row, so without this the next sync brought a deleted entry back. Keyed by the
// entry id the sync derives from the tag; an admin writing that entry again by hand removes it.
model ChangelogReleaseTombstone {
  id        String   @id
  version   String
  deletedAt DateTime @default(now())
}

// Daily aggregated usage metrics flushed from Redis counters
model UsageMetricDaily {
  id        String   @id @default(cuid())
  date      DateTime
  event     String
  count     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([date, event])
  @@index([event, date])
}

model UsageMetricFlushBatch {
  id        String   @id
  date      DateTime
  createdAt DateTime @default(now())

  @@index([date])
  @@index([createdAt])
}

model ViewFlushBatch {
  id        String   @id
  kind      String
  createdAt DateTime @default(now())

  @@index([kind, createdAt])
  @@index([createdAt])
}

// GitHub Stats sync record
model GitHubSync {
  id              String           @id @default(cuid())
  projectName     String
  projectUrl      String
  issueCount      Int              @default(0)
  onlyIssueCount  Int              @default(0)
  prCount         Int              @default(0)
  todoCount       Int              @default(0)
  inProgressCount Int              @default(0)
  doneCount       Int              @default(0)
  data            Json // Full GitHub data
  /// Not an HTTP ETag: holds the ISO time the previous GitHub fetch started, used as the next
  /// sync's `since` cursor (see syncGitHubStatsFromGitHub). Column reused, not renamed.
  etag            String?
  lastSyncStatus  String? // "ok" or "error" (services/github/issues.ts); detail in lastError
  lastError       String?
  nextSyncAt      DateTime?
  syncedAt        DateTime         @updatedAt
  createdAt       DateTime         @default(now())
  items           GitHubSyncItem[]

  @@unique([projectUrl])
  @@index([syncedAt])
}

model GitHubSyncItem {
  id         String     @id @default(cuid())
  syncId     String
  sync       GitHubSync @relation(fields: [syncId], references: [id], onDelete: Cascade)
  githubId   String
  number     Int
  title      String
  status     String
  kind       String
  url        String
  labels     String[]   @default([])
  createdAt  DateTime
  updatedAt  DateTime
  insertedAt DateTime   @default(now())

  // `[syncId]` was dropped (V-105): the unique and four indexes below lead with it. The rest stay:
  // `[status]`, `[kind]`, `[createdAt]`, `[updatedAt]` are the only ones leading with their
  // column, and each `[syncId, …, updatedAt]` has a different second column, so none is a prefix
  // of another.
  @@unique([syncId, githubId])
  @@index([status])
  @@index([kind])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([syncId, updatedAt])
  @@index([syncId, status, updatedAt])
  @@index([syncId, kind, updatedAt])
  @@index([syncId, status, kind, updatedAt])
}

// API Keys for rate limiting and access control
model ApiKey {
  id        String    @id @default(cuid())
  keyHash   String    @unique
  keyPrefix String
  keySuffix String
  name      String
  scopes    String[]  @default(["user:read"])
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  isActive  Boolean   @default(true)
  rateLimit Int       @default(20)
  expiresAt DateTime?
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  lastUsed  DateTime?

  // `[userId]` was dropped: `[userId, isActive]` leads with it. `[isActive]` is kept: no other
  // index leads with it, so the register's "redundant" call does not hold for it.
  @@index([userId, isActive])
  @@index([isActive])
  @@index([expiresAt])
  @@index([lastUsed])
}

// Audit log for tracking API access
model AuditLog {
  id        String   @id @default(cuid())
  method    String
  path      String
  status    Int
  ip        String?
  userAgent String?
  error     String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([method, path])
}
