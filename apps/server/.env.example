# =========================================================
# 🌐 Server Configuration
# =========================================================

NODE_ENV=development
PORT=8080
TRUST_PROXY=true
CLUSTERING_ENABLED=true
WEB_CONCURRENCY=2
SERVER_WORKERS=

# Max in-memory entries (leave empty for default)
MAX_MEMORY_ENTRIES=

# Allowed CORS origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004,http://localhost:8080

# =========================================================
# 🗄 Database (Neon / Postgres)
# =========================================================

# Database connection string
DATABASE_URL=

# Connection budget for the WHOLE cluster, not per process. The server forks one worker per CPU
# in production, and each worker opens its own pool, so the number that must fit inside Postgres'
# max_connections is (pool size x workers). Set this to roughly 80% of your instance's real
# max_connections; the per-worker pool is derived from it automatically.
DB_POOL_MAX_TOTAL=80

# Optional explicit per-process override. Leave unset unless a connection pooler (PgBouncer in
# transaction mode) sits in front — a stale value here is how you overcommit the database.
# DB_POOL_MAX=

DB_POOL_IDLE_TIMEOUT_MS=15000
DB_POOL_CONNECTION_TIMEOUT_MS=30000
DB_POOL_STATEMENT_TIMEOUT_MS=30000

# =========================================================
# ⚡ Redis (Cache, Sessions, Rate Limiting & Job Locks)
# =========================================================

REDIS_URL=redis://localhost:6379

# =========================================================
# 🔌 API Keys (Optional Integrations)
# =========================================================

GITHUB_SYNC_ENABLED=false
GITHUB_TOKEN=

# =========================================================
# 🔐 Security & Rate Limiting
# =========================================================

# Per-route rate limiting (15 minutes window). Keyed by (method, path, ip), so this bounds each
# endpoint independently — it is not a cap on a client's total load.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Coarse per-IP ceiling underneath the per-route limits above, so one client cannot issue
# RATE_LIMIT_MAX_REQUESTS against every endpoint separately. Should sit well above any real
# single-user session.
GLOBAL_RATE_LIMIT_WINDOW_MS=900000
GLOBAL_RATE_LIMIT_MAX_REQUESTS=1000

# Auth route rate limiting
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX_REQUESTS=20

# Privacy-safe anonymous analytics visitor identifier pepper
ANALYTICS_HASH_PEPPER=veriworkly-analytics-pepper

# =========================================================
# 🪵 Logging
# =========================================================

LOG_LEVEL=info

# AuditLog gets a row per 4xx/5xx response in production. Rows older than this are pruned by the
# daily usage-metrics job; nothing else deletes from that table.
AUDIT_LOG_RETENTION_DAYS=90

# =========================================================
# 🤖 AI Provider
# =========================================================

AI_API_KEY=
AI_BASE_URL=
AI_STANDARD_MODEL=
AI_EXPERT_MODEL=
# Three independent private policy files — point each _PATH to an ignored/mounted file, or
# inject the same JSON inline through the matching _JSON var. Keeping them separate makes it
# obvious which policy governs which feature; none of them are safe to commit.
# 1) General AI writing actions (rewrite/generate/tailor) — model routing, prompts, credit costs.
AI_ACTIONS_POLICY_PATH=
AI_ACTIONS_POLICY_JSON=
# 2) ATS AI-analysis layer (paid /ats/analyze insights + resume conversion) — prompts and pricing.
ATS_AI_POLICY_PATH=
ATS_AI_POLICY_JSON=
# 3) ATS deterministic scoring engine — rule weights, regex patterns, keyword synonym/phrase
#    dictionary. This is the part that must never be public, or the scoring becomes gameable.
ATS_ENGINE_POLICY_PATH=
ATS_ENGINE_POLICY_JSON=
AI_TIMEOUT_MS=120000
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX_REQUESTS=20
SITE_URL=https://veriworkly.com

# =========================================================
# 🔑 Authentication (Better-Auth)
# =========================================================

AUTH_SECRET='dev-auth-secret-1234567890'

# Base URL for auth callbacks
AUTH_BASE_URL=http://localhost:8080

# Cookie domain for shared subdomains (e.g. .veriworkly.com)
AUTH_COOKIE_DOMAIN=

# Headers consulted for IP address resolution
AUTH_IP_ADDRESS_HEADERS=x-client-ip,x-forwarded-for,x-real-ip,cf-connecting-ip

# Session TTL (30 days)
AUTH_SESSION_TTL_SECONDS=2592000

# Reset TTL on activity (seconds)
AUTH_SESSION_RESET_TTL_ON_USE=86400

# Enable session caching
AUTH_SESSION_CACHE_ENABLED=true

# Cache TTL (seconds)
AUTH_SESSION_CACHE_MAX_AGE_SECONDS=300

# OTP expiry (seconds)
AUTH_OTP_TTL_SECONDS=300

# Max OTP attempts
AUTH_OTP_ALLOWED_ATTEMPTS=3

# OAuth credentials (enabled when both client ID and secret are set)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# =========================================================
# 📧 Email Configuration
# =========================================================

ADMIN_EMAIL=
AUTH_EMAIL_FROM=

# Email provider (smtp, resend, etc.)
AUTH_EMAIL_PROVIDER=

# SMTP settings
AUTH_SMTP_HOST=
AUTH_SMTP_PORT=
AUTH_SMTP_SECURE= # true | false
AUTH_SMTP_USER=
AUTH_SMTP_PASS=

# =========================================================
# 📊 Usage Metrics
# =========================================================

# Cron schedule (daily at 00:10)
USAGE_METRICS_FLUSH_CRON=10 0 * * *
USAGE_METRICS_FLUSH_TIMEZONE=UTC
USAGE_METRICS_REDIS_RETENTION_DAYS=10

# =========================================================
# ⚡ Cache TTLs (seconds)
# =========================================================

ROADMAP_CACHE_TTL_SECONDS=2592000
ROADMAP_STATS_CACHE_TTL_SECONDS=2592000
ROADMAP_TAGS_CACHE_TTL_SECONDS=2592000
GITHUB_STATS_CACHE_TTL_SECONDS=43200
CHANGELOG_CACHE_TTL_SECONDS=2592000

# =========================================================
# 🐙 GitHub Sync (Scheduler)
# =========================================================

GITHUB_OWNER=
GITHUB_REPO=
GITHUB_PROJECT_URL=

# Runs twice daily
GITHUB_SYNC_CRON=0 0,12 * * *
GITHUB_SYNC_TIMEZONE=UTC

# Internal API protection key
INTERNAL_SYNC_API_KEY=

# =========================================================
# 📝 Changelog Release Sync (Scheduler)
# =========================================================

CHANGELOG_RELEASE_SYNC_ENABLED=true
CHANGELOG_RELEASE_SYNC_CRON=0 6 * * *
CHANGELOG_RELEASE_SYNC_TIMEZONE=UTC
CHANGELOG_RELEASE_SYNC_MIN_INTERVAL_SECONDS=21600

# =========================================================
# 🌐 Portfolio Subdomain Builder
# =========================================================
PORTFOLIO_URL=http://localhost:3004
PORTFOLIO_REVALIDATE_SECRET=dev-revalidate-secret

# =========================================================
# 💳 Creator Pro Billing (Dodo Payments)
# =========================================================

PORTFOLIO_GRACE_DAYS=7
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_SECRET=
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PAYMENTS_PORTFOLIO_PRO_MONTHLY_PRODUCT_ID=
DODO_PAYMENTS_PORTFOLIO_PRO_ANNUAL_PRODUCT_ID=
DODO_PAYMENTS_BUNDLE_ONE_DAY_PRODUCT_ID=
DODO_PAYMENTS_BUNDLE_SEVEN_DAY_PRODUCT_ID=
DODO_PAYMENTS_AI_CREDITS_MONTHLY_PRODUCT_ID=
DODO_PAYMENTS_AI_CREDITS_ANNUAL_PRODUCT_ID=
DODO_PAYMENTS_BUNDLE_MONTHLY_PRODUCT_ID=
DODO_PAYMENTS_BUNDLE_ANNUAL_PRODUCT_ID=
DODO_PAYMENTS_CREDIT_PACK_250_PRODUCT_ID=
DODO_PAYMENTS_CREDIT_PACK_500_PRODUCT_ID=
DODO_PAYMENTS_CHECKOUT_RETURN_URL=http://localhost:3001/billing?checkout=complete
DODO_PAYMENTS_CHECKOUT_CANCEL_URL=http://localhost:3001/billing?checkout=cancelled
DODO_PAYMENTS_PORTAL_RETURN_URL=http://localhost:3001/billing

# =========================================================
# ☁️ Portfolio Media (Cloudflare R2)
# =========================================================

R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=

# =========================================================
# 🚪 API Key Configuration
# =========================================================

API_KEY_HASH_SECRET=dev-api-key-secret
API_KEY_AUTH_CACHE_TTL_SECONDS=300
API_KEY_LAST_USED_TOUCH_INTERVAL_SECONDS=300
API_KEY_DEFAULT_RATE_LIMIT=20
API_KEY_MAX_RATE_LIMIT=600
API_KEY_DEFAULT_SCOPES=user:read
API_KEY_DEFAULT_LIFETIME_DAYS=365

# =========================================================
# 🚩 Growth Programs (Affiliate & Campus Ambassador)
# =========================================================

AFFILIATE_PROGRAM_ENABLED=
AMBASSADOR_PROGRAM_ENABLED=
