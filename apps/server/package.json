{
  "name": "@veriworkly/server",
  "version": "3.25.0",
  "description": "VeriWorkly Resume Backend API",
  "main": "dist/index.js",
  "type": "module",
  "imports": {
    "#*": {
      "types": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "predev": "npm run build -w @veriworkly/profile-core",
    "dev": "tsx watch src/index.ts",
    "prebuild": "npm run build -w @veriworkly/profile-core --if-present && prisma generate",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:redis": "npx redis-commander --redis-host 127.0.0.1 --redis-port 6379",
    "db:generate": "prisma generate",
    "sync:github": "tsx src/jobs/runGithubSyncOnce.ts",
    "sync:changelog": "tsx scripts/sync-changelog-releases.ts",
    "seed:roadmap": "tsx scripts/seed-roadmap.ts",
    "seed:changelog": "tsx scripts/seed-changelog.ts",
    "backfill:changelog-pr-authors": "tsx scripts/backfill-changelog-pr-authors.ts",
    "preview:emails": "tsx scripts/generate-email-previews.ts",
    "test": "vitest run",
    "test:watch": "vitest --watch"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/s3-request-presigner": "^3.1146.0",
    "@better-auth/prisma-adapter": "~1.6.25",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@prisma/config": "^7.10.0",
    "@veriworkly/ats-engine": "^0.1.0",
    "@veriworkly/profile-core": "*",
    "better-auth": "~1.6.25",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dodopayments": "^2.52.0",
    "dotenv": "^17.4.2",
    "express": "^4.22.3",
    "helmet": "^7.2.0",
    "libphonenumber-js": "^1.13.14",
    "mammoth": "^1.13.0",
    "multer": "^2.4.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.0.14",
    "openai": "^6.49.0",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "5.4.296",
    "pg": "^8.23.1",
    "redis": "^5.12.1",
    "resend": "^6.32.0",
    "throng": "^5.0.0",
    "uuid": "^14.0.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/multer": "^2.3.0",
    "@types/node": "^25",
    "@types/pg": "^8.23.1",
    "@types/throng": "^5.0.7",
    "eslint": "^9",
    "prettier": "^3.9.9",
    "prisma": "^7.10.0",
    "tsx": "^4.23.15",
    "typescript": "^6",
    "vitest": "^4.1.11"
  }
}
