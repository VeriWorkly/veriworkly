# =========================================================
# 🎨 Frontend & API Configuration
# =========================================================

# Canonical public origin (no trailing slash), e.g. https://veriworkly.com
# Used for canonical URLs, Open Graph URLs, JSON-LD, sitemap and robots entries.
#
# Must be NEXT_PUBLIC_: siteConfig is imported by client components, and only
# NEXT_PUBLIC_* vars are inlined into the browser bundle. Set at BUILD time -
# metadata for statically prerendered pages is baked in at build, not at boot.
NEXT_PUBLIC_SITE_URL=

# Deprecated server-only alias for NEXT_PUBLIC_SITE_URL. Still honoured as a
# fallback so existing deployments keep working; prefer the variable above.
SITE_URL=

# Public API URL (used in browser/client-side code)
# Must start with NEXT_PUBLIC_ for frontend exposure.
# Also seeds the CSP connect-src / form-action allow-list in next.config.ts.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080/api/v1

# Internal API URL. Server-side fetches prefer this over the public URL so
# container-to-container traffic never leaves the private network.
BACKEND_INTERNAL_URL=http://localhost:8080/api/v1

# Origin used to resolve the logo embedded in generated OG images (/api/og).
# Optional - falls back to NEXT_PUBLIC_SITE_URL when unset.
NEXT_PUBLIC_APP_URL=

# =========================================================
# 👤 Admin Configuration
# =========================================================

# Should match the ADMIN_EMAIL in Backend .env (and studio/.env) for consistency across apps.
# Lets the admin bypass the production-only payments block on the pricing page.
# Server-only on purpose: never expose this to the client, only the resulting boolean.
ADMIN_EMAIL=

# =========================================================
# 🚩 Growth Program Feature Flags
# =========================================================

# Gate the /ambassador/apply and affiliate enrolment flows. Must match the equivalent
# flags on the backend's growth routers - the marketing site checks them before it calls
# the API, because a 503 from a flagged-off endpoint is otherwise indistinguishable from
# "signed out" and produced a login redirect loop.
#
# Accepted truthy values: 1, true, yes, on. Default is ON outside production and OFF in
# production, so a production deploy that forgets these keeps the programs closed rather
# than advertising an apply page that cannot accept anything.
AFFILIATE_PROGRAM_ENABLED=
AMBASSADOR_PROGRAM_ENABLED=

# =========================================================
# 📦 Build
# =========================================================

# Set to 1 only for container builds that run `node apps/site/server.js`.
# Cloud deploys using `next start` should leave this unset.
BUILD_STANDALONE=
