# Only the first three are needed for local development.

# This app's own origin, no trailing slash. Build-time. Falls back to https://veriworkly.com.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# API the browser calls (contact form, ATS checker). Build-time. Also allowed in the CSP.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080/api/v1

# API the server-side render calls. Runtime. In Docker: http://api:8080/api/v1.
BACKEND_INTERNAL_URL=http://localhost:8080/api/v1

# Production: the API's ALLOWED_ORIGINS must include this site's origin (https://veriworkly.com).
# Server-side calls send it as Origin; without it the API answers 401 and the changelog, roadmap
# and stats pages quietly show their outage state.

# Same value as the API's INTERNAL_API_KEY. Runtime, optional. Lets the API rate-limit the
# signed-in ambassador page per visitor instead of per site server. Empty: one shared bucket.
INTERNAL_API_KEY=

# Growth programs (/affiliate, /ambassador). Runtime, re-read every 5 minutes. Accepts 1, true,
# yes, on. Empty means on in development and off in production. Keep equal to the API's flags.
AFFILIATE_PROGRAM_ENABLED=
AMBASSADOR_PROGRAM_ENABLED=

# Lets the API refresh the changelog and roadmap after a release (POST /api/revalidate).
# Runtime. Same value as the API's SITE_REVALIDATE_SECRET, at least 32 characters. Empty turns
# the route off, and pages then refresh on the weekly timer only.
SITE_REVALIDATE_SECRET=

# Plain-JSON receivers, both optional. Empty sends nothing (errors go to stderr instead).
# An OTLP collector such as SigNoz does not accept this format.
ERROR_REPORT_URL=
NEXT_PUBLIC_VITALS_URL=

# Set to 1 only for container builds that run `node apps/site/server.js`.
BUILD_STANDALONE=
