# =========================================================
# 🎨 Frontend & API Configuration
# =========================================================

SITE_URL=http://localhost:3004
NEXT_PUBLIC_APP_URL=http://localhost:3004

# Public API URL (used in browser/client-side code)
# Must start with NEXT_PUBLIC_ for frontend exposure
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080/api/v1

# Internal API URL
BACKEND_INTERNAL_URL=http://localhost:8080/api/v1

# =========================================================
# 👤 Admin Configuration
# =========================================================

# Should match the ADMIN_EMAIL in Backend .env (and studio/site .env) for consistency across apps.
# Lets the admin bypass the production-only publish/payments blocks.
ADMIN_EMAIL=

# =========================================================
# 🎨 Portfolio SECRET
# =========================================================
PORTFOLIO_REVALIDATE_SECRET=
