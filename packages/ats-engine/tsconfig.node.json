{
  // The Node-only subpaths (/node, the CLI) need Node's types; everything else must compile
  // without them, so a stray `Buffer` in the browser-safe core fails `tsconfig.json`. This
  // project builds the whole package, Node parts included.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node"]
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "tests"]
}
