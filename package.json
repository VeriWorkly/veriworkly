{
  "name": "veriworkly",
  "version": "3.31.0",
  "private": true,
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/VeriWorkly/veriworkly.git"
  },
  "workspaces": [
    "apps/site",
    "apps/studio",
    "apps/portfolio",
    "apps/blog-platform",
    "apps/docs-platform",
    "apps/server",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @veriworkly/site",
    "dev:site": "npm run dev -w @veriworkly/site -- -p 3000",
    "dev:studio": "npm run dev -w @veriworkly/studio -- -p 3001",
    "dev:docs": "npm run dev -w @veriworkly/docs-platform -- -p 3002",
    "dev:blog": "npm run dev -w @veriworkly/blog-platform -- -p 3003",
    "dev:portfolio": "npm run dev -w @veriworkly/portfolio -- -p 3004",
    "dev:server": "npm run dev -w @veriworkly/server",
    "postinstall": "npm run db:generate",
    "build:profile-core": "npm run build -w @veriworkly/profile-core",
    "dev:all": "npm run dev --workspaces --if-present",
    "build": "npm run build:profile-core && npm run build --workspaces --if-present",
    "build:site": "npm run build -w @veriworkly/site",
    "build:studio": "npm run build:profile-core && npm run build -w @veriworkly/studio",
    "build:blog": "npm run build -w @veriworkly/blog-platform",
    "build:docs": "npm run build -w @veriworkly/docs-platform",
    "build:portfolio": "npm run build:profile-core && npm run build -w @veriworkly/portfolio",
    "build:server": "npm run build:profile-core && npm run build -w @veriworkly/server",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "generate:api": "npm run generate:api -w @veriworkly/docs-platform",
    "db:migrate": "npm run db:migrate -w @veriworkly/server",
    "db:generate": "npm run db:generate -w @veriworkly/server",
    "db:studio": "npm run db:studio -w @veriworkly/server",
    "db:redis": "npm run db:redis -w @veriworkly/server",
    "seo:gsc": "node scripts/seo-data/gsc.mjs",
    "seo:bing": "node scripts/seo-data/bing.mjs",
    "seo:all": "npm run seo:gsc && npm run seo:bing",
    "seo:inspect": "node scripts/seo-data/gsc-inspect.mjs",
    "seo:bing-urls": "node scripts/seo-data/bing-urls.mjs",
    "db:migrate:deploy": "npm run db:migrate:deploy -w @veriworkly/server"
  },
  "devDependencies": {
    "@types/node": "^25",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^7"
  },
  "optionalDependencies": {
    "@esbuild/linux-x64": "^0.28.1",
    "@rolldown/binding-linux-x64-gnu": "^1.2.1",
    "@tailwindcss/oxide-linux-x64-gnu": "^4.3.3",
    "lightningcss-linux-x64-gnu": "^1.33.0"
  }
}
